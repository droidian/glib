From: Simon McVittie <smcv@debian.org>
Date: Tue, 21 Oct 2025 13:45:14 +0100
Subject: girepository: Search for typelibs in the pre-multiarch path

The majority of GIR typelibs are now installed in
/usr/lib/${DEB_HOST_MULTIARCH}/girepository-1.0, but a small number of
packages still install typelibs into /usr/lib/girepository-1.0.

This patch can (and should) be dropped after the result of
`apt-file search /usr/lib/girepository-1.0` becomes empty.
See bug reports:
https://udd.debian.org/cgi-bin/bts-usertags.cgi?user=pkg-gnome-maintainers%40lists.alioth.debian.org&tag=usr-lib-girepository-1.0

Bug-Debian: https://bugs.debian.org/1099192
Forwarded: not-needed
---
 girepository/girepository.c                  | 4 ++++
 girepository/tests/repository-search-paths.c | 9 ++++++---
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/girepository/girepository.c b/girepository/girepository.c
index 1c816d1..c1421b8 100644
--- a/girepository/girepository.c
+++ b/girepository/girepository.c
@@ -306,6 +306,10 @@ gi_repository_init (GIRepository *repository)
       typelib_dir = g_build_filename (libdir, "girepository-1.0", NULL);
 
       g_ptr_array_add (repository->typelib_search_path, g_steal_pointer (&typelib_dir));
+
+      /* Debian-specific, should be removed after
+       * `apt-file search /usr/lib/girepository-1.0` stops returning results */
+      g_ptr_array_add (repository->typelib_search_path, g_strdup ("/usr/lib/girepository-1.0"));
     }
 
   repository->library_paths = g_ptr_array_new_null_terminated (1, g_free, TRUE);
diff --git a/girepository/tests/repository-search-paths.c b/girepository/tests/repository-search-paths.c
index a80fc8b..bc286cc 100644
--- a/girepository/tests/repository-search-paths.c
+++ b/girepository/tests/repository-search-paths.c
@@ -50,12 +50,13 @@ test_repository_search_paths_default (void)
 
   search_paths = gi_repository_get_search_path (repository, &n_search_paths);
   g_assert_nonnull (search_paths);
-  g_assert_cmpuint (g_strv_length ((char **) search_paths), ==, 2);
+  g_assert_cmpuint (g_strv_length ((char **) search_paths), ==, 3);
 
   g_assert_cmpstr (search_paths[0], ==, g_get_tmp_dir ());
 
   char *expected_path = test_repository_search_paths_get_expected_libdir_path ();
   g_assert_cmpstr (search_paths[1], ==, expected_path);
+  g_assert_cmpstr (search_paths[2], ==, "/usr/lib/girepository-1.0");
   g_clear_pointer (&expected_path, g_free);
 
   g_clear_object (&repository);
@@ -73,19 +74,20 @@ test_repository_search_paths_prepend (void)
   gi_repository_prepend_search_path (repository, g_test_get_dir (G_TEST_BUILT));
   search_paths = gi_repository_get_search_path (repository, &n_search_paths);
   g_assert_nonnull (search_paths);
-  g_assert_cmpuint (g_strv_length ((char **) search_paths), ==, 3);
+  g_assert_cmpuint (g_strv_length ((char **) search_paths), ==, 4);
 
   g_assert_cmpstr (search_paths[0], ==, g_test_get_dir (G_TEST_BUILT));
   g_assert_cmpstr (search_paths[1], ==, g_get_tmp_dir ());
 
   char *expected_path = test_repository_search_paths_get_expected_libdir_path ();
   g_assert_cmpstr (search_paths[2], ==, expected_path);
+  g_assert_cmpstr (search_paths[3], ==, "/usr/lib/girepository-1.0");
   g_clear_pointer (&expected_path, g_free);
 
   gi_repository_prepend_search_path (repository, g_test_get_dir (G_TEST_DIST));
   search_paths = gi_repository_get_search_path (repository, &n_search_paths);
   g_assert_nonnull (search_paths);
-  g_assert_cmpuint (g_strv_length ((char **) search_paths), ==, 4);
+  g_assert_cmpuint (g_strv_length ((char **) search_paths), ==, 5);
 
   g_assert_cmpstr (search_paths[0], ==, g_test_get_dir (G_TEST_DIST));
   g_assert_cmpstr (search_paths[1], ==, g_test_get_dir (G_TEST_BUILT));
@@ -93,6 +95,7 @@ test_repository_search_paths_prepend (void)
 
   expected_path = test_repository_search_paths_get_expected_libdir_path ();
   g_assert_cmpstr (search_paths[3], ==, expected_path);
+  g_assert_cmpstr (search_paths[4], ==, "/usr/lib/girepository-1.0");
   g_clear_pointer (&expected_path, g_free);
 
   g_clear_object (&repository);
