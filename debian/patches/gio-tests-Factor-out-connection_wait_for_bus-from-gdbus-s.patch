 void ensure_gdbus_testserver_up (GDBusConnection *connection,
                                  GMainContext    *context);
 
+void connection_wait_for_bus (GDBusConnection *conn);
+
 G_END_DECLS
 
 #endif /* __TESTS_H__ */
