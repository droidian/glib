@@ -0,0 +1,30 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
+ * Copyright 2025 Simon McVittie
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#include <stdio.h>
+
+#include <glib.h>
+
+/*
+ * Output the hard-coded GObject-Introspection search path for GLib itself,
+ * within GLib's ${prefix}.
+ * This is a subset of what's used in locate_gir() in girparser.c,
+ * and is used to find GLib-2.0.gir, GObject-2.0.gir, Gio-2.0.gir
+ * when integration-testing gi-compile-repository.
+ */
+int
+main (int    argc,
+      char **argv)
+{
+  puts (/* might be "/usr/lib/x86_64-linux-gnu/gir-1.0" */
+        GIR_DIR
+        G_SEARCHPATH_SEPARATOR_S
+        /* might be "/usr/share" + "/" + "gir-1.0" */
+        GOBJECT_INTROSPECTION_DATADIR G_DIR_SEPARATOR_S GIR_SUFFIX);
+  return 0;
+}
