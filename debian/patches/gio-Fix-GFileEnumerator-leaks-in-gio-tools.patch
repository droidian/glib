From: correctmost <136447-correctmost@users.noreply.gitlab.gnome.org>
Date: Sat, 2 Nov 2024 17:06:37 -0400
Subject: gio: Fix GFileEnumerator leaks in gio tools

Origin: upstream, 2.82.3, commit:2dd1395e0524ace1fb8bbf59eeedd427d419326c
---
 gio/gio-tool-list.c  | 2 ++
 gio/gio-tool-trash.c | 2 ++
 gio/gio-tool-tree.c  | 2 +-
 3 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/gio/gio-tool-list.c b/gio/gio-tool-list.c
index 0da8626..aafdb85 100644
--- a/gio/gio-tool-list.c
+++ b/gio/gio-tool-list.c
@@ -157,6 +157,8 @@ list (GFile *file)
       res = FALSE;
     }
 
+  g_object_unref (enumerator);
+
   return res;
 }
 
diff --git a/gio/gio-tool-trash.c b/gio/gio-tool-trash.c
index 6e6137f..65a29f8 100644
--- a/gio/gio-tool-trash.c
+++ b/gio/gio-tool-trash.c
@@ -204,6 +204,8 @@ trash_list (GFile         *file,
       res = FALSE;
     }
 
+  g_object_unref (enumerator);
+
   return res;
 }
 
diff --git a/gio/gio-tool-tree.c b/gio/gio-tool-tree.c
index 28fad05..e26fb6a 100644
--- a/gio/gio-tool-tree.c
+++ b/gio/gio-tool-tree.c
@@ -106,7 +106,7 @@ do_tree (GFile *f, unsigned int level, guint64 pattern)
 	      info_list = g_list_prepend (info_list, info);
 	    }
 	}
-      g_file_enumerator_close (enumerator, NULL, NULL);
+      g_object_unref (enumerator);
 
       info_list = g_list_sort (info_list, (GCompareFunc) sort_info_by_name);
 
